# ${BACKEND_URL} is filled in from the environment when the container starts.
server {
    listen 80;
    root /usr/share/nginx/html;

    server_tokens off;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/css application/javascript application/json application/geo+json image/svg+xml;

    # Same role as the Vite dev proxy: /api/events -> ${BACKEND_URL}/events
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
    }

    # React app: unknown paths fall back to index.html
    location / {
        try_files $uri /index.html;
    }
}
